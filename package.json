{
  "name": "spin-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Spin on the desktop: Haru's ZZZ-styled Jellyfin music player",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p electron/tsconfig.json && wait-on tcp:5185 && cross-env VITE_DEV_SERVER_URL=http://localhost:5185 electron .",
    "build": "tsc -p tsconfig.json && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "test": "node --test tests/transport.test.ts",
    "package": "npm run build && electron-builder --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wait-on": "9.1.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
